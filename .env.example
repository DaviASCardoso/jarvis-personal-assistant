# Copie para `.env` e ajuste conforme necessário.
# Todas as variáveis do Jarvis usam o prefixo JARVIS_.
# `.env` não é versionado: nenhuma credencial real entra neste arquivo.

# Ambiente de execução: development | test | production
JARVIS_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO

# Diretório para dados locais gerados em runtime (relativo à raiz do projeto)
JARVIS_DATA_DIR=data

# --- Agent Runtime (Fase 4) -------------------------------------------------
# Fornecedor de LLM usado para raciocínio. Hoje só `gemini`.
JARVIS_LLM_PROVIDER=gemini

# Credencial do Google AI Studio. Sem ela, os comandos `jarvis agent ...`
# falham de forma explícita; todo o resto do sistema continua funcionando.
JARVIS_GEMINI_API_KEY=

# Modelo de raciocínio. É configuração de propósito: o catálogo do provider
# muda mais rápido que este repositório.
JARVIS_GEMINI_MODEL=gemini-3.6-flash

# Orçamento por chamada ao modelo
JARVIS_LLM_TIMEOUT_SECONDS=30
JARVIS_LLM_MAX_OUTPUT_TOKENS=1024
JARVIS_LLM_TEMPERATURE=0.2
JARVIS_LLM_MAX_ATTEMPTS=2

# Abaixo deste score de importância, um evento não vira chamada ao LLM
JARVIS_AGENT_IMPORTANCE_THRESHOLD=0.45

# --- Fase 5: política, execução e tools -------------------------------------
# Allowlist de capacidades. Uma skill cuja capacidade não esteja aqui é NEGADA.
# O default cobre exatamente as skills embutidas; vazio nega tudo, de propósito.
JARVIS_POLICY_GRANTED_CAPABILITIES=system:read,file:read,file:write

# Denylists estáticas. Valem independentemente do risco que a skill autodeclara.
JARVIS_POLICY_DENIED_SKILLS=
JARVIS_POLICY_DENIED_EFFECTS=

# Efeitos e nível de risco que exigem confirmação explícita do usuário
JARVIS_POLICY_CONFIRM_EFFECTS=destructive,physical,external_communication,spend
JARVIS_POLICY_CONFIRM_RISK=high

# Risco a partir do qual a ação é negada sem apelação
JARVIS_POLICY_DENY_RISK=critical

# Uma aprovação atravessa uma execução; uma confirmação espera por uma pessoa
JARVIS_APPROVAL_TTL_SECONDS=60
JARVIS_CONFIRMATION_TTL_SECONDS=900

# Raiz allowlistada das skills de arquivo. Caminho fora dela é recusado pelo
# backend, independentemente do que a política disser.
JARVIS_FILE_SKILL_ROOT=data/workspace

# Orçamento por chamada de tool. Repetição só acontece em skill idempotente.
JARVIS_TOOL_TIMEOUT_SECONDS=20
JARVIS_TOOL_MAX_ATTEMPTS=2

# Arquivo de MCP Servers. Ausente = nenhum servidor, e todo o resto funciona.
# O arquivo nomeia variáveis de ambiente em `env_keys`; nunca contém credenciais.
JARVIS_MCP_CONFIG=

# --- Fase 6: voz ------------------------------------------------------------
# Áudio exige o extra opcional: `uv sync --extra voice`. Sem ele, todo o resto
# do Jarvis continua funcionando e só os comandos de voz falham, com instrução.
#
# ATENÇÃO, privacidade: com a voz ligada, o áudio dos seus enunciados vai para a
# Groq e o texto das respostas vai para o Google. Com
# JARVIS_WAKE_STRATEGY=transcription, trechos curtos do ambiente também são
# enviados enquanto o modo de escuta estiver ativo.

# Transcrição (voz → texto). Hoje só `groq`.
JARVIS_STT_PROVIDER=groq
JARVIS_GROQ_API_KEY=
JARVIS_STT_MODEL=whisper-large-v3-turbo
# Vazio = o provider detecta o idioma
JARVIS_STT_LANGUAGE=pt
JARVIS_STT_TIMEOUT_SECONDS=30
JARVIS_STT_MAX_ATTEMPTS=2
# Teto de transcrições por minuto no modo de wake word por transcrição
JARVIS_STT_WAKE_BUDGET_PER_MINUTE=12

# Síntese (texto → voz). Hoje só `google`.
JARVIS_TTS_PROVIDER=google
JARVIS_GOOGLE_TTS_API_KEY=
JARVIS_TTS_VOICE=pt-BR-Neural2-B
JARVIS_TTS_LANGUAGE=pt-BR
JARVIS_TTS_SPEAKING_RATE=1.0
JARVIS_TTS_SAMPLE_RATE=24000
JARVIS_TTS_TIMEOUT_SECONDS=15
JARVIS_TTS_MAX_CHARS=1200

# Wake word: push_to_talk (Enter no terminal) ou transcription (fala o nome).
# O default não manda áudio nenhum para a nuvem antes de você pedir.
JARVIS_WAKE_STRATEGY=push_to_talk
JARVIS_WAKE_PHRASES=jarvis
JARVIS_WAKE_MAX_EDIT_DISTANCE=1

# Dispositivos: índice ou parte do nome; vazio = padrão do sistema.
# `jarvis voice devices` lista o que existe na máquina.
JARVIS_VOICE_INPUT_DEVICE=
JARVIS_VOICE_OUTPUT_DEVICE=
JARVIS_VOICE_SAMPLE_RATE=16000

# Interromper a fala do Jarvis falando por cima. Pressupõe fone: sem ele, o
# alto-falante alimenta o microfone e a interrupção dispara sozinha.
JARVIS_VOICE_BARGE_IN=true
JARVIS_VOICE_BARGE_IN_RMS=0.06

# Detecção de fala (VAD), determinística e sem modelo
JARVIS_VAD_RMS_THRESHOLD=0.02
JARVIS_VAD_MIN_SPEECH_MS=300
JARVIS_VAD_SILENCE_MS=800
JARVIS_VAD_MAX_UTTERANCE_SECONDS=20

# Sessão: janela de escuta sem wake word, silêncio que encerra, teto de turnos
JARVIS_VOICE_FOLLOW_UP_SECONDS=12
JARVIS_VOICE_IDLE_TIMEOUT_SECONDS=45
JARVIS_VOICE_MAX_TURNS=40

# Dias de retenção das transcrições em data/voice.db. 0 desliga o expurgo.
JARVIS_VOICE_RETENTION_DAYS=7

# Submeter ações propostas por voz ao Policy Engine. Opt-in, como `--execute`.
JARVIS_VOICE_EXECUTE_ACTIONS=false

# --- Fase 6: painel ---------------------------------------------------------
# Somente leitura e só em loopback. Expor na rede exigiria autenticação.
JARVIS_PANEL_HOST=127.0.0.1
JARVIS_PANEL_PORT=8765
JARVIS_PANEL_REFRESH_SECONDS=2.0
JARVIS_PANEL_TIMELINE_LIMIT=50
JARVIS_PANEL_MEMORY_LIMIT=10
JARVIS_PANEL_OPEN_BROWSER=false

# Copie para `.env` e ajuste conforme necessário.
# Todas as variáveis do Jarvis usam o prefixo JARVIS_.

# Ambiente de execução: development | test | production
JARVIS_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO

# Diretório para dados locais gerados em runtime (relativo à raiz do projeto)
JARVIS_DATA_DIR=data
